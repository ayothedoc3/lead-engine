# --- 60-Second Lead Engine: per-client config ---
# Copy to .env and fill in for each client deployment.

# Auth
ANTHROPIC_API_KEY=sk-ant-...
RESEND_API_KEY=re_...
# Shared secret: the form sends it as X-Lead-Secret; booking webhooks and /stats use ?key=
# Generate one: python -c "import secrets; print(secrets.token_hex(24))"
LEAD_ENGINE_SECRET=change-me

# Model (claude-opus-4-7 for best quality; a faster model keeps replies quicker at volume)
LEAD_ENGINE_MODEL=claude-opus-4-7

# Client branding (drives every reply)
CLIENT_NAME=Acme Agency
# How replies should sound: paste the client's real voice and positioning.
CLIENT_VOICE=Warm, concise, professional. Short sentences, no jargon, no hype. Sign off as "The Acme team".
BOOKING_LINK=https://calendly.com/acme/intro
# IANA time zone; follow-ups only go out 9:00 to 18:00 on weekdays here.
CLIENT_TIMEZONE=America/New_York

# Email (FROM_EMAIL must be on a Resend-verified domain)
FROM_EMAIL=Acme Agency <hello@acmeagency.com>
# Where the lead's replies land
REPLY_TO_EMAIL=owner@acmeagency.com
# Where new-lead alerts and forwarded text replies go
ALERT_EMAIL=owner@acmeagency.com

# Deployment
# Public HTTPS URL of this engine (used for stop links and Twilio signature checks)
PUBLIC_BASE_URL=https://leads.acmeagency.com
# SQLite file on a persistent volume
DATABASE_PATH=/data/lead-engine.db

# --- Lead Engine Pro features (leave blank to switch off) ---

# Follow-ups: days after the lead arrives. Stops when they book, text back or you click stop.
FOLLOWUP_DAYS=1,3,5

# SMS via Twilio. Requires an approved A2P 10DLC campaign on the Messaging Service.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# CRM: HubSpot private app token (scopes: crm.objects.contacts.write) and/or any webhook URL
HUBSPOT_TOKEN=
CRM_WEBHOOK_URL=
